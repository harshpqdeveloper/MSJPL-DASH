# Copy to .env and fill in for local `npm run dev`.
# See README.md's "Visitor analytics" section.

# Email + password required to sign in to /analytics.
ANALYTICS_ADMIN_EMAIL=
ANALYTICS_ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie, e.g. generate with:
#   openssl rand -hex 32
ANALYTICS_SESSION_SECRET=

# Supabase project — stores the latest Excel file (Storage) and the analytics_events table.
# SUPABASE_SECRET_KEY is the service (secret) key; SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=msjpl-excel

# Shared secret the local Excel Auto Sync program sends to /api/excel/upload-url + finalize.
SYNC_API_KEY=
